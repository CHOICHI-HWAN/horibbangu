{
  "hosting": {
    "public": "site",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "*.rules",
      "*.md",
      "*.sql",
      "desktop/**",
      "tests/**",
      "downloads/**",
      ".git/**",
      ".firebase/**",
      "room/shell.html",
      "room/room.js",
      "room/room.css",
      "scripts/**",
      "room/assets/**",
      "**/*.png",
      "**/*.jpg",
      "**/*.JPG",
      "**/*.jpeg",
      "**/*.heic",
      "**/*.HEIC",
      "**/*.log"
    ],
    "headers": [
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/records.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/room/cats-extra.css",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/releases/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/releases/Horibbangu-Windows.zip",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/zip"
          },
          {
            "key": "Content-Disposition",
            "value": "attachment; filename=\"Horibbangu-Windows.zip\""
          }
        ]
      },
      {
        "source": "/releases/Horibbangu-Windows.exe",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/octet-stream"
          },
          {
            "key": "Content-Disposition",
            "value": "attachment; filename=\"Horibbangu-Windows.exe\"; filename*=UTF-8''%ED%98%B8%EB%A6%AC%EB%B9%B5%EA%B5%AC.exe"
          }
        ]
      }
    ],
    "predeploy": [
      "python3 scripts/build-hosting.py"
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
