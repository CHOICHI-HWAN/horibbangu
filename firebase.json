{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "*.rules",
      "*.md",
      "*.sql",
      "desktop/**",
      "tests/**",
      "downloads/**",
      ".git/**",
      ".firebase/**",
      "**/*.exe",
      "**/*.zip",
      "room/shell.html",
      "room/room.js",
      "room/room.css",
      "scripts/**",
      "room/assets/**",
      "/*.png"
    ],
    "headers": [
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/records.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/room/cats-extra.css",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
